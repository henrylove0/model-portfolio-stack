# ---- Public (exposed to the browser, safe to be public) ----
# Your Cloudflare R2 custom domain, e.g. https://cdn.example.com
# Leave empty during early development to use built-in placeholder images.
VITE_R2_PUBLIC_URL=

# ---- Server-only (NEVER expose, NEVER commit to git) ----
# Set these in: Vercel dashboard -> Project -> Settings -> Environment Variables

# Cloudflare R2 (create token: Cloudflare dashboard -> R2 -> Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=model-portfolio

# Admin login. Generate a hash with: npm run password
ADMIN_PASSWORD_HASH=
# Random secret for signing admin sessions: openssl rand -hex 32
SESSION_SECRET=

# TEMPORARY: set to "1" to let anyone into the CMS without a password (pre-content
# testing only). Remove + redeploy before launch — password login then takes over.
CMS_DISABLE_AUTH=
